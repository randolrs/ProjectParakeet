# Copy to .env.local (Next.js) / .env (scripts, drizzle-kit) and fill in.
# NEVER commit real secrets. Service role + secret keys are server-only.

# --- Database (Supabase Postgres) ---
# Use the pooled connection (port 6543) for the app; the direct connection
# (port 5432) for drizzle-kit migrations.
DATABASE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Opportunity source selection ---
# "govconapi" (v1 primary) or "sam" (fallback). Default: govconapi.
OPPORTUNITY_SOURCE=govconapi
GOVCONAPI_KEY=
# SAM.gov direct: starts at 10 requests/day, reaches 1,000/day only after
# entity registration clears (~2-3 weeks).
SAM_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Email ---
RESEND_API_KEY=

# --- Billing (TODO: M5) ---
STRIPE_SECRET_KEY=

# --- Cron / ops ---
# Shared secret guarding cron route handlers.
CRON_SECRET=
# Founder address used as the first test recipient.
FOUNDER_EMAIL=
